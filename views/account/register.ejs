
<div class="account-container">
    
   <% if (title) { %>
        <div>
            <h1><%= title %></h1>
            <%- messages() %>
        </div>
    <% } %>
    <% if (errors) { %>
        <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
        </ul>
        <% } %>
    <div class="register-box">

        <form action="/account/register" method="post">
            <label>First name</label>
            <input type="text" name="account_firstname" id="account_firstname" required>

            <label>Last name</label>
            <input type="text" name="account_lastname" id="account_lastname" required>

            <label>Email address</label>
            <input type="email" name="account_email" id="account_email"  required placeholder="Enter a valid email address">

            <label>Password</label>
            <div class="password-wrapper">
            <input 
                type="password" 
                id="account_password" 
                name="account_password" 
                required pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
            >
            <i class="fa-solid fa-eye toggle-eye" onclick="togglePassword()"></i>
            </div>

            <ul class="password-rules">
                <li>Minimum 12 characters</li>
                <li>At least 1 capital letter</li>
                <li>At least 1 number</li>
                <li>At least 1 special character</li>
            </ul>

            <button type="submit">Register</button>
        </form>
    </div>
</div>