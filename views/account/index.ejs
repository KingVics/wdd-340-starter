<section class="">
     <% if (title) { %>
        <div>
            <h1><%= title %></h1>
            <%- messages() %>
        </div>
    <% } %>
    <% if (errors) { %>
        <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
        </ul>
        <% } %>
    
  <!-- Welcome Message -->
  <h2>Welcome <%= accountData.account_firstname %></h2>

  <!-- Update Account Link (for ALL users) -->
  <p>
    <a href="/account/update/<%= accountData.account_id %>" 
       title="Update your account information">
       Update Account Information
    </a>
  </p>

  <!-- Inventory Section (ONLY Employee/Admin) -->
  <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>

    <div class="account-inventory">
      <h3>Inventory Management</h3>

     <p>
        <a href="/inv/" title="Manage Inventory">
          Go to Inventory Management
        </a>
      </p>

    </div>
  <% } %>
</section>