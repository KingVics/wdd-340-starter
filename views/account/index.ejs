<section class="">
     <% if (title) { %>
        <div>
            <h1><%= title %></h1>
            <%- messages() %>
        </div>
    <% } %>
    <% if (errors) { %>
        <ul class="notice">
        <% errors.array().forEach(error => { %>
        <li><%= error.msg %></li>
        <%  }) %>
        </ul>
        <% } %>
    <div class="info">
        <p>You are logged in as <%= accountData.account_firstname %> <%= accountData.account_lastname %></p>
    </div>
</section>