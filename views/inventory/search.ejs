<section class="search-page">
    <% if (title) { %>
        <div class="search-hero">
            <div class="search-copy">
                <p class="eyebrow">Find your next ride</p>
                <h1><%= title %></h1>
                <p class="search-lead">
                    Narrow the inventory by keyword, budget, vehicle type, model year, and mileage.
                </p>
            </div>
            <div class="search-hero-card">
                <p>Quick picks</p>
                <ul>
                    <li>Daily drivers under budget</li>
                    <li>Low-mileage weekend cars</li>
                    <li>Newest arrivals by class</li>
                </ul>
            </div>
        </div>
    <% } %>

    <%- messages() %>

    <% if (errors && errors.array().length) { %>
        <ul class="notice">
            <% errors.array().forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <section class="search-layout">
        <aside class="search-panel">
            <h2>Filters</h2>
            <form class="search-form" method="get" action="/inv/search">
                <label for="keyword">Keyword</label>
                <input
                    type="search"
                    id="keyword"
                    name="keyword"
                    maxlength="40"
                    value="<%= filters.keyword %>"
                    placeholder="Delorean, SUV, luxury..."
                />

                <label for="classification">Classification</label>
                <select id="classification" name="classification">
                    <option value="">All classifications</option>
                    <% classifications.forEach(classification => { %>
                        <option
                            value="<%= classification.classification_id %>"
                            <%= String(filters.classification) === String(classification.classification_id) ? "selected" : "" %>>
                            <%= classification.classification_name %>
                        </option>
                    <% }) %>
                </select>

                <div class="search-form-grid">
                    <div>
                        <label for="minPrice">Min Price</label>
                        <input type="number" id="minPrice" name="minPrice" min="0" step="1000" value="<%= filters.minPrice %>" placeholder="5000" />
                    </div>
                    <div>
                        <label for="maxPrice">Max Price</label>
                        <input type="number" id="maxPrice" name="maxPrice" min="0" step="1000" value="<%= filters.maxPrice %>" placeholder="45000" />
                    </div>
                </div>

                <div class="search-form-grid">
                    <div>
                        <label for="minYear">Min Year</label>
                        <input type="number" id="minYear" name="minYear" min="1900" max="2099" value="<%= filters.minYear %>" placeholder="2018" />
                    </div>
                    <div>
                        <label for="maxMiles">Max Miles</label>
                        <input type="number" id="maxMiles" name="maxMiles" min="0" step="1000" value="<%= filters.maxMiles %>" placeholder="60000" />
                    </div>
                </div>

                <label for="sort">Sort By</label>
                <select id="sort" name="sort">
                    <option value="price-asc" <%= filters.sort === "price-asc" ? "selected" : "" %>>Price: Low to High</option>
                    <option value="price-desc" <%= filters.sort === "price-desc" ? "selected" : "" %>>Price: High to Low</option>
                    <option value="year-desc" <%= filters.sort === "year-desc" ? "selected" : "" %>>Newest First</option>
                    <option value="miles-asc" <%= filters.sort === "miles-asc" ? "selected" : "" %>>Lowest Mileage</option>
                </select>

                <div class="search-actions">
                    <button type="submit">Apply Filters</button>
                    <a href="/inv/search" class="search-reset">Reset</a>
                </div>
            </form>
        </aside>

        <div class="search-results">
            <div class="results-header">
                <div>
                    <p class="eyebrow">Browse inventory</p>
                    <h2><%= hasActiveFilters ? "Search results" : "Available vehicles" %></h2>
                    <p class="results-summary">
                        <%= resultsCount %> vehicle<%= resultsCount === 1 ? "" : "s" %> found
                        <% if (filters.keyword) { %>
                            for <span class="keyword-chip">"<%= displayKeyword %>"</span>
                        <% } %>
                    </p>
                </div>
                <a href="/inv/" class="results-link">Manage inventory</a>
            </div>

            <% if (searchResults && searchResults.length) { %>
                <div class="search-results-grid">
                    <% searchResults.forEach(vehicle => { %>
                        <article class="search-card">
                            <a href="/inv/detail/<%= vehicle.inv_id %>" class="search-card-image">
                                <img src="<%= vehicle.inv_thumbnail %>" alt="Image of <%= vehicle.inv_make %> <%= vehicle.inv_model %>" />
                            </a>
                            <div class="search-card-body">
                                <p class="search-card-tag"><%= vehicle.classification_name %></p>
                                <h3>
                                    <a href="/inv/detail/<%= vehicle.inv_id %>">
                                        <%= vehicle.inv_year %> <%= vehicle.inv_make %> <%= vehicle.inv_model %>
                                    </a>
                                </h3>
                                <dl class="search-card-specs">
                                    <div>
                                        <dt>Price</dt>
                                        <dd>$<%= new Intl.NumberFormat("en-US").format(vehicle.inv_price) %></dd>
                                    </div>
                                    <div>
                                        <dt>Miles</dt>
                                        <dd><%= new Intl.NumberFormat("en-US").format(vehicle.inv_miles) %></dd>
                                    </div>
                                </dl>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <div class="search-empty">
                    <h3>No vehicles matched those filters</h3>
                    <p>Try a broader keyword, adjust your budget, or reset the filters to browse everything in stock.</p>
                </div>
            <% } %>
        </div>
    </section>
</section>
