<header id="top-header">
    <span class="siteName">
        <a href="/" title="Return to home page">CSE Motors</a>
    </span>
    <form class="header-search" method="get" action="/inv/search">
        <label class="search-label" for="site-search">Search inventory</label>
        <input
            id="site-search"
            name="keyword"
            type="search"
            maxlength="40"
            placeholder="Search inventory"
            aria-label="Search inventory"
        />
    </form>
    <div id="tools">
        <% if (loggedin) { %>
        <p>Welcome Back</p>
       <div class="logout">
         <a title="Click to log out" href="/account/logout" class="logout-btn">Logout</a>
       </div>
        <% } else { %>
            <a title="Click to log in" href="/account/login">My Account</a>
        <% } %>
    </div>
</header>
